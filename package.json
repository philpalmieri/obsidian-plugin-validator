{
  "name": "obsidian-plugin-validator",
  "version": "1.0.7-rc.0",
  "description": "Run Obsidian community-plugin review checks locally before you submit.",
  "type": "module",
  "bin": {
    "obsidian-plugin-validator": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node bin/cli.mjs",
    "test": "node --test test/cli.test.mjs",
    "test:package": "node --test scripts/package.test.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "validate",
    "lint",
    "eslint",
    "manifest",
    "community-plugin"
  ],
  "author": "Phil Palmieri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philpalmieri/obsidian-plugin-validator.git"
  },
  "bugs": {
    "url": "https://github.com/philpalmieri/obsidian-plugin-validator/issues"
  },
  "homepage": "https://github.com/philpalmieri/obsidian-plugin-validator#readme",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "obsidian": {
      "moment": "^2.31.0"
    }
  },
  "bundleDependencies": [
    "eslint-plugin-obsidianmd"
  ]
}
